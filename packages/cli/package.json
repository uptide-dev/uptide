{
  "name": "uptide",
  "version": "0.14.3",
  "description": "Uptide finds what a dependency upgrade breaks in your code, migrates it, and proves it with your compiler and tests.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "uptide": "./dist/index.js"
  },
  "exports": {
    "./onboarding": {
      "types": "./dist/onboarding/index.d.ts",
      "import": "./dist/onboarding/index.js"
    },
    "./onboarding/node": {
      "types": "./dist/onboarding/node.d.ts",
      "import": "./dist/onboarding/node.js"
    },
    "./report": {
      "types": "./dist/report/index.d.ts",
      "import": "./dist/report/index.js"
    },
    "./report/schema.json": "./dist/report/schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/metafile-*.json",
    "NOTICE",
    "THIRD-PARTY-NOTICES"
  ],
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uptide-dev/uptide.git",
    "directory": "packages/cli"
  },
  "homepage": "https://uptide-dev.github.io/docs",
  "bugs": "https://github.com/uptide-dev/uptide/issues",
  "keywords": [
    "zod",
    "stripe",
    "upgrade",
    "migration",
    "codemod",
    "breaking-changes",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.libs.config.ts && node scripts/third-party-notices.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/prepack.mjs --clean"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@types/node": "^22.0.0",
    "@uptide/core": "workspace:*",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.296"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  }
}
