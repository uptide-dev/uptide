// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`friendly failures: each says what to run next > a copy above the project root is not its install (UPT-136) 1`] = `
[
  "  Next: pnpm install --frozen-lockfile",
]
`;

